// Prisma schema for the Mini Food Ordering System.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Lifecycle of an order. New orders always start as PENDING.
enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERING
  DELIVERED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  /// Stored normalized (trimmed, lower-case).
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@map("users")
}

model Restaurant {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  description String
  cuisine     String   @db.VarChar(60)
  address     String   @db.VarChar(255)
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  menuItems MenuItem[]
  orders    Order[]

  @@map("restaurants")
}

model MenuItem {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String   @db.VarChar(120)
  description  String
  /// Price in the smallest currency unit (cents) to avoid floating point errors.
  priceCents   Int      @map("price_cents")
  isAvailable  Boolean  @default(true) @map("is_available")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([restaurantId])
  @@map("menu_items")
}

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  status       OrderStatus @default(PENDING)
  /// Sum of all line totals in cents, calculated on the server.
  totalCents   Int         @map("total_cents")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items      OrderItem[]

  @@index([userId])
  @@index([restaurantId])
  @@map("orders")
}

/// A line of an order. Name and unit price are snapshotted at order time,
/// so later menu changes never alter historical orders.
model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  menuItemId     String @map("menu_item_id") @db.Uuid
  name           String @db.VarChar(120)
  unitPriceCents Int    @map("unit_price_cents")
  quantity       Int

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([orderId, menuItemId])
  @@index([menuItemId])
  @@map("order_items")
}
