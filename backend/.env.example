# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port of the API
PORT=3001

# PostgreSQL connection string used by both the Prisma CLI and the app
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_food?schema=public"

# JWT signing secret (min. 32 characters) and token lifetime (e.g. 15m, 1h, 1d)
JWT_SECRET="change-me-to-a-long-random-string-of-32-chars-or-more"
JWT_EXPIRES_IN=1h

# Comma-separated list of origins allowed to call the API (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000
